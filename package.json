{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "clean:metro": "node -e \"const fs=require('fs');const p=['.expo'];for(const d of p){try{fs.rmSync(d,{recursive:true,force:true});}catch(e){}}\"",
    "clean:android": "node -e \"const fs=require('fs');const p=['android/build','android/app/build','android/.gradle'];for(const d of p){try{fs.rmSync(d,{recursive:true,force:true});}catch(e){}}\"",
    "clean:all": "npm run clean:metro && npm run clean:android",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "postinstall": "patch-package",
    "prepare": "husky",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android:apk:local": "cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@10play/tentap-editor": "^1.0.1",
