+  private data class MessagingLine(val text: String, val timestamp: Long, val senderName: String?)
+
+  private fun parseMessagingLinesFromBody(content: INotificationContent): List<MessagingLine> {
+    val body = content.body ?: return emptyList()
+    val raw = body.optJSONArray("messagingLines") ?: return emptyList()
+    val lines = mutableListOf<MessagingLine>()
+    for (i in 0 until raw.length()) {
+      val row = raw.optJSONObject(i) ?: continue
+      val text = row.optString("text", "").trim()
+      if (text.isEmpty()) continue
+      val timestamp = row.optLong("timestamp", System.currentTimeMillis())
+      val senderName = row.optString("senderName", "").trim().takeIf { it.isNotEmpty() }
+      lines.add(MessagingLine(text, timestamp, senderName))
+    }
+    return lines
+  }
